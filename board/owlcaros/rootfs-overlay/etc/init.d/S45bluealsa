#!/bin/sh

DAEMON="bluealsa"
PIDFILE="/var/run/$DAEMON.pid"

start() {
    printf 'Starting %s: ' "$DAEMON"

    start-stop-daemon --start --background --make-pidfile \
        --pidfile "$PIDFILE" \
        --exec "/usr/bin/$DAEMON" \
        -- --profile=a2dp-sink

    status=$?
    if [ "$status" -eq 0 ]; then
        echo "OK"
    else
        echo "FAIL"
    fi

    return "$status"
}

stop() {
    printf 'Stopping %s: ' "$DAEMON"

    start-stop-daemon --stop --pidfile "$PIDFILE" \
        --exec "/usr/bin/$DAEMON"

    status=$?
    if [ "$status" -eq 0 ]; then
        echo "OK"
        rm -f "$PIDFILE"
    else
        echo "FAIL"
    fi
    return "$status"
}

case "$1" in
    start|stop)
        "$1"
        ;;
    restart)
        stop
        start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
