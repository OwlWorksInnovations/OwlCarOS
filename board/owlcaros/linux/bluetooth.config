# Bluetooth core
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m

# Bluetooth USB transport
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_AUTOSUSPEND=y

# Bluetooth device drivers
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIUART_INTEL=y
CONFIG_BT_HCIUART_ATH3K=y
CONFIG_BT_HCIBTSDIO=m
# Virtual HCI controller, for testing the Bluetooth stack without hardware
CONFIG_BT_HCIVHCI=m
CONFIG_BT_HCIBTUSB_MTK=y

# Bluetooth audio and media support
CONFIG_BT_A2MP=y
CONFIG_BT_LEDS=y

# HD Audio codec support. Built in rather than modular: the image has no
# udev-style modalias autoloading, so a modular codec never binds and the
# sound card would not appear at boot.
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_CIRRUS=y
CONFIG_SND_HDA_CODEC_HDMI=y
