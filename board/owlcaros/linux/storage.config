CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y

# Internal drives the installer can target. Built in, because the kernel
# has to mount the root filesystem from them before any module can load.
CONFIG_BLK_DEV_NVME=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
