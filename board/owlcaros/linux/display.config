# Display and text console support
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y

# Use the firmware/bootloader framebuffer on BIOS/UEFI systems.
# Without SYSFB_SIMPLEFB, simpledrm never binds to the EFI/VESA
# framebuffer, so the local display stays black.
CONFIG_SYSFB_SIMPLEFB=y

# QEMU's default "-vga std" adapter
CONFIG_DRM_BOCHS=y
